{
  "name": "shinobi",
  "version": "0.1.0",
  "private": true,
  "description": "Is this professor taking PhD students? Reads their page, their grants and their publications and gives a verdict.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "features": "node --env-file-if-exists=.env scripts/features.ts",
    "batch": "node --env-file-if-exists=.env scripts/batch.ts",
    "typecheck": "tsc",
    "test": "node --test 'src/**/*.test.ts' 'web/src/*.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.95",
    "@mastra/core": "1.76.0",
    "@mastra/mongodb": "1.23.0",
    "@mastra/observability": "^1.19.0",
    "@mastra/sentry": "^1.2.25",
    "mongodb": "^7.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mastra": "1.34.0",
    "typescript": "^5.9.0"
  }
}
