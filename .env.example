# Copy to .env. Never commit .env.
# With Docker Compose, MONGODB_URI is overridden to the mongo container; set it here for `npm run dev` on the host.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=shinobi
SESSION_SECRET=   # openssl rand -hex 32

# Required for a check
SERPAPI_API_KEY=      # finds the faculty page, https://serpapi.com (free tier)

# The page reader: any OpenAI-compatible server hosting Gemma, with GEMMA_MODEL as the name that server expects.
# Leave GEMMA_BASE_URL empty to use Google AI Studio with GOOGLE_GENERATIVE_AI_API_KEY and GEMMA_MODEL=google/gemma-4-26b-a4b-it.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
OPENALEX_API_KEY=     # lifts the unkeyed OpenAlex rate limit
SENTRY_DSN=           # traces every run; off when empty
