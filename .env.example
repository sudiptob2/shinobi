# Copy to .env. Never commit .env.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=shinobi
GOOGLE_GENERATIVE_AI_API_KEY=
SERPAPI_API_KEY=
PRIORLABS_API_KEY=
SENTRY_DSN=
OPENALEX_API_KEY=
# Gemma host. Leave GEMMA_BASE_URL empty for Google AI Studio (GEMMA_MODEL=google/gemma-4-26b-a4b-it).
# Or point at any OpenAI-compatible server and name the model as that server knows it.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
SESSION_SECRET=   # openssl rand -hex 32
